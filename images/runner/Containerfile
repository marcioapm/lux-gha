# lux-gha runner: GitHub's official runner, run once with the JIT config Lux
# places as a file secret, plus rootless Docker for Lux nested Runs
# (sandbox.nestedContainers). Built for linux/arm64 and linux/amd64; the
# rootless dockerd and BuildKit preload checks (smoke.sh --privileged) have
# run natively on arm64, and on amd64 only in CI's native image job.

# ubuntu:24.04, multi-arch index digest (resolved 2026-10-10).
ARG UBUNTU_IMAGE=docker.io/library/ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55

# moby/buildkit for setup-buildx-action's docker-container builder, shipped
# as an OCI archive that the entrypoint loads into the per-Run Docker store.
# BUILDKIT_DIGEST is the multi-arch index that buildx-stable-1 and
# BUILDKIT_VERSION pointed to (resolved 2026-10-15); the per-arch digests are
# its linux/arm64 and linux/amd64 manifests.
ARG BUILDKIT_VERSION=v0.33.1
ARG BUILDKIT_DIGEST=sha256:cec9f139f45e93c5c69c60f8b07cfad9f43f4ef6b6a6cd917527fea5ff2e3dea
ARG BUILDKIT_DIGEST_ARM64=sha256:3ad6bb9bc8c78c0069d03247adb9a59b3b43d68e55353e876e558b888c6c1768
ARG BUILDKIT_DIGEST_AMD64=sha256:98cc6a3fc46220d00f8224ae483f3274fc874e9be8d7dd1e2e2c5481209228b5

# regctl v0.11.3, alpine variant (has a shell), multi-arch index digest. Runs
# on the build platform: it only moves bytes.
FROM --platform=$BUILDPLATFORM ghcr.io/regclient/regctl:v0.11.3-alpine@sha256:246f275efc7d627bb3b6561317ff2742f5fcc574d86bbe276ddd417f19f98744 AS buildkit-fetch
ARG TARGETARCH
ARG BUILDKIT_VERSION
ARG BUILDKIT_DIGEST
ARG BUILDKIT_DIGEST_ARM64
ARG BUILDKIT_DIGEST_AMD64
USER root
SHELL ["/bin/sh", "-eux", "-c"]
# An OCI layout holding the pinned index plus the TARGETARCH manifest and its
# blobs only. Keeping the index makes the loaded image's ID the index digest,
# as a pull from Docker Hub would, so a later pull of either tag resolves to
# content already in the store. The fetch is anonymous from Docker Hub and
# counts against its pull limit for the build host's IP. The index's
# version annotation must equal BUILDKIT_VERSION, so that the digest and the
# tag it is filed under cannot drift apart.
RUN case "$TARGETARCH" in \
      arm64) want=$BUILDKIT_DIGEST_ARM64 ;; \
      amd64) want=$BUILDKIT_DIGEST_AMD64 ;; \
      *) echo "unsupported TARGETARCH $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    ref="docker.io/moby/buildkit:${BUILDKIT_VERSION}@${BUILDKIT_DIGEST}"; \
    version=$(regctl manifest get --format '{{index .GetAnnotations "org.opencontainers.image.version"}}' "$ref"); \
    [ "$version" = "$BUILDKIT_VERSION" ] || { echo "index $BUILDKIT_DIGEST is version '$version', pinned $BUILDKIT_VERSION" >&2; exit 1; }; \
    got=$(regctl manifest get --platform "linux/$TARGETARCH" --format '{{.GetDescriptor.Digest}}' "$ref"); \
    [ "$got" = "$want" ] || { echo "index $BUILDKIT_DIGEST lists $got for linux/$TARGETARCH, pinned $want" >&2; exit 1; }; \
    regctl image copy "docker.io/moby/buildkit@$want" ocidir:///oci:fetched; \
    regctl manifest get --format raw-body "$ref" >"/oci/blobs/sha256/${BUILDKIT_DIGEST#sha256:}"; \
    size=$(wc -c <"/oci/blobs/sha256/${BUILDKIT_DIGEST#sha256:}"); \
    entry() { printf '{"mediaType":"application/vnd.oci.image.index.v1+json","digest":"%s","size":%s,"annotations":{"io.containerd.image.name":"docker.io/moby/buildkit:%s","org.opencontainers.image.ref.name":"%s"}}' \
      "$BUILDKIT_DIGEST" "$size" "$1" "$1"; }; \
    printf '{"schemaVersion":2,"mediaType":"application/vnd.oci.image.index.v1+json","manifests":[%s,%s]}\n' \
      "$(entry buildx-stable-1)" "$(entry "$BUILDKIT_VERSION")" >/oci/index.json

# Every blob is checked against its file name, the digest that the index, the
# manifest and the pins above refer to. GNU tar for a byte-stable archive.
# The archive and its parent directories get fixed modes and mtime 0, so that
# the COPY --link below yields the same layer digest on every build: a
# parent directory that COPY creates itself gets the build's wall-clock mtime.
FROM --platform=$BUILDPLATFORM $UBUNTU_IMAGE AS buildkit-archive
ARG BUILDKIT_DIGEST
SHELL ["/bin/sh", "-eux", "-c"]
COPY --from=buildkit-fetch /oci /oci
RUN cd /oci/blobs/sha256; \
    [ -f "${BUILDKIT_DIGEST#sha256:}" ]; \
    for f in *; do echo "$f  $f"; done | sha256sum -c --quiet -; \
    d=/out/usr/share/lux-gha; \
    install -d -m 0755 /out /out/usr /out/usr/share "$d"; \
    tar -C /oci -cf "$d/buildkit.tar" --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner --mode=u=rw,go=r,a+X \
      oci-layout index.json blobs; \
    chmod 0644 "$d/buildkit.tar"; \
    touch -d @0 "$d/buildkit.tar" "$d" /out/usr/share /out/usr /out

FROM $UBUNTU_IMAGE

ARG TARGETARCH
ARG RUNNER_VERSION=2.338.0
# Occurrences of the UTF-16LE literal ACTIONS_RESULTS_URL in this version's
# bin/Runner.Worker.dll (patch-worker.sh count), the same on every
# architecture. A runner bump that changes it fails the build: re-measure
# and check that patch-worker.sh still applies (README "Using the cache server").
ARG RUNNER_RESULTS_URL_LITERALS=1
# SHA-256 of actions-runner-linux-<arch>-2.338.0.tar.gz, from the v2.338.0
# release notes (also the asset digests the GitHub releases API reports).
ARG RUNNER_SHA256_ARM64=628b4a7258487b80c1d3c221095a7ded349f5ae0175fd3dfab708d07428f041b
ARG RUNNER_SHA256_AMD64=af4b794c1bc41d73d40535e3fe092a39f9679cd8d965954c2aca25a05ca41d32
# Versions from download.docker.com/linux/ubuntu noble stable, present for
# both arm64 and amd64.
ARG DOCKER_VERSION=5:29.9.0-1~ubuntu.24.04~noble
ARG CONTAINERD_VERSION=2.4.1-2~ubuntu.24.04~noble
ARG BUILDX_VERSION=0.38.0-1~ubuntu.24.04~noble
ARG COMPOSE_VERSION=5.6.0-1~ubuntu.24.04~noble
# Docker Release (CE deb) <docker@docker.com>
ARG DOCKER_GPG_FINGERPRINT=9DC858229FC7DD38854AE2D88D81803C0EBFCD88
# AWS Session Manager plugin, for `aws ssm start-session` port forwarding. AWS
# publishes no checksum file; these are the SHA-256 of the versioned debs
# (resolved 2026-10-19), so a changed upload fails the build.
ARG SSM_PLUGIN_VERSION=1.2.896.0
ARG SSM_PLUGIN_SHA256_AMD64=53f51fcc67314a4bf85888a38a3967cd41f8d0f28a60a9469a63acf935ba713e
ARG SSM_PLUGIN_SHA256_ARM64=914eeca87b18b55356c58be197080f73742b3ca60d3823f0a45670dc9056aa9c
# Versioned AWS CLI v2 archives (resolved 2026-10-19).
ARG AWS_CLI_VERSION=2.38.1
ARG AWS_CLI_SHA256_AMD64=b11ed416d91f4251da363a17706938eeaf0e520745754c104c0c1890dd8363c7
ARG AWS_CLI_SHA256_ARM64=91360c0adb2ae508334ff657dce4787b598b443a11cf3dc58e08b74f12e16009

LABEL org.opencontainers.image.source="https://github.com/marcioapm/lux-gha" \
      org.opencontainers.image.description="lux-gha one-shot GitHub Actions runner with rootless Docker" \
      org.opencontainers.image.licenses="Elastic-2.0" \
      io.github.actions.runner.version="${RUNNER_VERSION}"

SHELL ["/bin/sh", "-eux", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl gnupg; \
    install -d -m 0755 /etc/apt/keyrings; \
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /tmp/docker.asc; \
    fpr=$(gpg --batch --with-colons --show-keys /tmp/docker.asc | awk -F: '$1 == "fpr" {print $10; exit}'); \
    [ "$fpr" = "$DOCKER_GPG_FINGERPRINT" ]; \
    gpg --batch --dearmor -o /etc/apt/keyrings/docker.gpg /tmp/docker.asc; \
    rm /tmp/docker.asc; \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu noble stable" \
      > /etc/apt/sources.list.d/docker.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      "docker-ce=${DOCKER_VERSION}" "docker-ce-cli=${DOCKER_VERSION}" \
      "docker-ce-rootless-extras=${DOCKER_VERSION}" "containerd.io=${CONTAINERD_VERSION}" \
      "docker-buildx-plugin=${BUILDX_VERSION}" "docker-compose-plugin=${COMPOSE_VERSION}" \
      uidmap libcap2-bin fuse-overlayfs slirp4netns iptables iproute2 \
      git jq unzip xz-utils python3 libatomic1 socat; \
    apt-get purge -y --auto-remove gnupg; \
    rm -rf /var/lib/apt/lists/*

RUN case "$TARGETARCH" in \
      arm64) dir=ubuntu_arm64 sha=$SSM_PLUGIN_SHA256_ARM64 ;; \
      amd64) dir=ubuntu_64bit sha=$SSM_PLUGIN_SHA256_AMD64 ;; \
      *) echo "unsupported TARGETARCH $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL --retry 3 --retry-all-errors -o /tmp/ssm.deb \
      "https://s3.amazonaws.com/session-manager-downloads/plugin/${SSM_PLUGIN_VERSION}/${dir}/session-manager-plugin.deb"; \
    echo "${sha}  /tmp/ssm.deb" | sha256sum -c -; \
    dpkg -i /tmp/ssm.deb; \
    rm /tmp/ssm.deb

RUN case "$TARGETARCH" in \
      arm64) arch=aarch64 sha=$AWS_CLI_SHA256_ARM64 ;; \
      amd64) arch=x86_64 sha=$AWS_CLI_SHA256_AMD64 ;; \
      *) echo "unsupported TARGETARCH $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL --retry 3 --retry-all-errors -o /tmp/awscliv2.zip \
      "https://awscli.amazonaws.com/awscli-exe-linux-${arch}-${AWS_CLI_VERSION}.zip"; \
    echo "${sha}  /tmp/awscliv2.zip" | sha256sum -c -; \
    unzip -q /tmp/awscliv2.zip -d /tmp/awscli; \
    /tmp/awscli/aws/install; \
    rm -rf /tmp/awscliv2.zip /tmp/awscli

# docker-credential-ecr-login, behind docker-credential-lux-gha, for the
# in-region registry. SHA-256 from the release's per-binary .sha256 files
# (resolved 2026-10-23).
ARG ECR_LOGIN_VERSION=0.12.0
ARG ECR_LOGIN_SHA256_AMD64=a22ab6d59dbac777b8fb31984709461da00a4c778b6ae14c8d3729e8d5ded1a6
ARG ECR_LOGIN_SHA256_ARM64=5bdd30fb6c7a92462f5b454cce1aa906ca7926a6c2e39efad9613a7bf7661fac
RUN case "$TARGETARCH" in \
      arm64) sha=$ECR_LOGIN_SHA256_ARM64 ;; \
      amd64) sha=$ECR_LOGIN_SHA256_AMD64 ;; \
      *) echo "unsupported TARGETARCH $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL --retry 3 --retry-all-errors -o /tmp/docker-credential-ecr-login \
      "https://amazon-ecr-credential-helper-releases.s3.us-east-2.amazonaws.com/${ECR_LOGIN_VERSION}/linux-${TARGETARCH}/docker-credential-ecr-login"; \
    echo "${sha}  /tmp/docker-credential-ecr-login" | sha256sum -c -; \
    install -m 0755 /tmp/docker-credential-ecr-login /usr/local/bin/docker-credential-ecr-login; \
    rm /tmp/docker-credential-ecr-login

# The base image's "ubuntu" user holds uid 1000.
RUN userdel -r ubuntu; \
    useradd -m -u 1000 -U -s /bin/bash runner; \
    printf 'runner:1:999\nrunner:1001:64535\n' > /etc/subuid; \
    cp /etc/subuid /etc/subgid; \
    install -d -o runner -g runner -m 0755 /opt/hostedtoolcache

COPY --chmod=755 patch-worker.sh /usr/local/lib/lux-gha/patch-worker.sh
WORKDIR /home/runner/actions-runner
RUN case "$TARGETARCH" in \
      arm64) arch=arm64 sha=$RUNNER_SHA256_ARM64 ;; \
      amd64) arch=x64 sha=$RUNNER_SHA256_AMD64 ;; \
      *) echo "unsupported TARGETARCH $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/runner.tar.gz \
      "https://github.com/actions/runner/releases/download/v${RUNNER_VERSION}/actions-runner-linux-${arch}-${RUNNER_VERSION}.tar.gz"; \
    echo "${sha}  /tmp/runner.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/runner.tar.gz; \
    rm /tmp/runner.tar.gz; \
    /usr/local/lib/lux-gha/patch-worker.sh check "$RUNNER_RESULTS_URL_LITERALS" bin/Runner.Worker.dll; \
    /usr/local/lib/lux-gha/patch-worker.sh helper run-helper.sh.template; \
    apt-get update; \
    ./bin/installdependencies.sh; \
    rm -rf /var/lib/apt/lists/*; \
    mkdir -p /home/runner/.local/share/docker; \
    chown -R runner:runner /home/runner

# Preinstalled tool cache: each tool sits at <tool>/<version>/<arch> with an
# <arch>.complete marker, the layout @actions/tool-cache's find() requires, so
# a setup-* action whose version spec matches uses it without a download.
# find() checks only the directory and marker, so content no setup-* action
# or normal job reads is deleted in the same RUN: the JDK's lib/src.zip,
# CPython's test suite and its static libpython (about 220 MB together).

# CPython from actions/python-versions, installed by its bundled setup.sh as
# setup-python does, so that its RUNPATH /opt/hostedtoolcache/Python/<v>/<arch>/lib
# resolves. setup.sh force-reinstalls pip; PIP_NO_INDEX with the bundled wheel
# keeps that offline and the result reproducible (pip from ensurepip).
# SHA-256 are the release asset digests the GitHub releases API reports.
ARG PYTHON_VERSION=3.11.17
ARG PYTHON_RELEASE=3.11.17-36876195594
ARG PYTHON_SHA256_ARM64=a7a7bb9e6b50483f393d1c44c87aa87677a0464a9e3b07f33ee5b31ce155c6ef
ARG PYTHON_SHA256_AMD64=ae713815fe406a06f1691856f697a0b1e58b3e986f44e62f0cd0bca2424f1aac
RUN case "$TARGETARCH" in \
      arm64) arch=arm64 sha=$PYTHON_SHA256_ARM64 ;; \
      amd64) arch=x64 sha=$PYTHON_SHA256_AMD64 ;; \
      *) echo "unsupported TARGETARCH $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    f=python-${PYTHON_VERSION}-linux-24.04-${arch}.tar.gz; \
    curl -fsSL --retry 3 --retry-all-errors -o "/tmp/$f" \
      "https://github.com/actions/python-versions/releases/download/${PYTHON_RELEASE}/$f"; \
    echo "${sha}  /tmp/$f" | sha256sum -c -; \
    install -d -o runner -g runner /tmp/python; \
    setpriv --reuid=runner --regid=runner --init-groups tar -xzf "/tmp/$f" -C /tmp/python; \
    (cd /tmp/python && setpriv --reuid=runner --regid=runner --init-groups env \
      HOME=/home/runner RUNNER_TOOL_CACHE=/opt/hostedtoolcache AGENT_TOOLSDIRECTORY=/opt/hostedtoolcache \
      LD_LIBRARY_PATH=/tmp/python/lib PIP_NO_INDEX=1 PIP_FIND_LINKS="/tmp/python/lib/python${PYTHON_VERSION%.*}/ensurepip/_bundled" \
      bash ./setup.sh); \
    rm -rf "/tmp/$f" /tmp/python /home/runner/.cache; \
    [ -f "/opt/hostedtoolcache/Python/${PYTHON_VERSION}/${arch}.complete" ]; \
    l=/opt/hostedtoolcache/Python/${PYTHON_VERSION}/${arch}/lib; \
    rm -r "$l/python${PYTHON_VERSION%.*}/test" "$l/python${PYTHON_VERSION%.*}"/config-*/libpython*.a

# Temurin JDK from Adoptium. setup-java names the directory after the Adoptium
# API's version_data.semver with its first "+" replaced by "-"
# (getToolcacheVersionName); any other name is a silent cache miss. Adoptium
# maps jdk-A.B.C[.P]+N to A.B.C+(P*100+N), with ".0.LTS" appended when the
# build's release file says "-LTS" and nothing otherwise (API, 2026-10-20:
# 25.0.4+101.0.LTS, 26.0.2+101, 17.0.20+101). The build fails unless
# JAVA_TOOLCACHE_VERSION is one of the two forms and the release file agrees;
# smoke.sh repeats the derivation. setup-java v4/v5 look
# under os.arch() (arm64), v6 under its normalised name (aarch64); on arm64
# aarch64 is a symlink to arm64 with its own marker, so both find it.
# SHA-256 are the package checksums the Adoptium API publishes.
ARG JAVA_RELEASE=jdk-25.0.4.1+1
ARG JAVA_TOOLCACHE_VERSION=25.0.4-101.0.LTS
ARG JAVA_SHA256_ARM64=69df11a02cfa3ef7d7ca645e03edce6778ec090e100f6ae2b42097865730ac52
ARG JAVA_SHA256_AMD64=dbb698396d478e7fa2b1e50f4103324b2a99b90569ee27c33f2261f9215cf41e
RUN case "$TARGETARCH" in \
      arm64) arch=aarch64 tc=arm64 alias=aarch64 sha=$JAVA_SHA256_ARM64 ;; \
      amd64) arch=x64 tc=x64 alias= sha=$JAVA_SHA256_AMD64 ;; \
      *) echo "unsupported TARGETARCH $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    v=${JAVA_RELEASE#jdk-}; \
    jtc=$(echo "$v" | awk -F+ '{split($1, a, "."); printf "%d.%d.%d-%d", a[1], a[2], a[3], a[4] * 100 + $2}'); \
    case "$JAVA_TOOLCACHE_VERSION" in \
      "$jtc.0.LTS") rv="$v-LTS" ;; \
      "$jtc") rv=$v ;; \
      *) echo "JAVA_TOOLCACHE_VERSION $JAVA_TOOLCACHE_VERSION does not match $JAVA_RELEASE: want $jtc.0.LTS (LTS) or $jtc (non-LTS)" >&2; exit 1 ;; \
    esac; \
    major=${v%%[.+]*}; \
    f=OpenJDK${major}U-jdk_${arch}_linux_hotspot_$(echo "$v" | tr + _).tar.gz; \
    curl -fsSL --retry 3 --retry-all-errors -o "/tmp/$f" \
      "https://github.com/adoptium/temurin${major}-binaries/releases/download/$(echo "$JAVA_RELEASE" | sed 's/+/%2B/')/$f"; \
    echo "${sha}  /tmp/$f" | sha256sum -c -; \
    d=/opt/hostedtoolcache/Java_Temurin-Hotspot_jdk/${JAVA_TOOLCACHE_VERSION}; \
    install -d -o runner -g runner "${d%/*}" "$d" "$d/$tc"; \
    setpriv --reuid=runner --regid=runner --init-groups tar -xzf "/tmp/$f" -C "$d/$tc" --strip-components=1; \
    rm "/tmp/$f" "$d/$tc/lib/src.zip"; \
    grep -qx "JAVA_RUNTIME_VERSION=\"$rv\"" "$d/$tc/release" || \
      { echo "$d/$tc/release does not name $rv, which JAVA_TOOLCACHE_VERSION $JAVA_TOOLCACHE_VERSION implies" >&2; exit 1; }; \
    if [ -n "$alias" ]; then ln -s "$tc" "$d/$alias"; chown -h runner:runner "$d/$alias"; fi; \
    for a in "$tc" $alias; do setpriv --reuid=runner --regid=runner --init-groups touch "$d/$a.complete"; done

# Node.js from nodejs.org, laid out as setup-node's cache step leaves it (the
# tarball with its top directory stripped). SHA-256 are from the release's
# SHASUMS256.txt.
ARG NODE_VERSION=26.10.0
ARG NODE_SHA256_ARM64=7a6353f63eb3d04765004b4adf172616243e4522434635cb1d26288658b04ab5
ARG NODE_SHA256_AMD64=ca70e9e349de048b9522abb3adc05b3bd6f43c5ffd3ec57916c7da292f59f022
RUN case "$TARGETARCH" in \
      arm64) arch=arm64 sha=$NODE_SHA256_ARM64 ;; \
      amd64) arch=x64 sha=$NODE_SHA256_AMD64 ;; \
      *) echo "unsupported TARGETARCH $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    f=node-v${NODE_VERSION}-linux-${arch}.tar.xz; \
    curl -fsSL --retry 3 --retry-all-errors -o "/tmp/$f" "https://nodejs.org/dist/v${NODE_VERSION}/$f"; \
    echo "${sha}  /tmp/$f" | sha256sum -c -; \
    d=/opt/hostedtoolcache/node/${NODE_VERSION}; \
    install -d -o runner -g runner "${d%/*}" "$d" "$d/$arch"; \
    setpriv --reuid=runner --regid=runner --init-groups tar -xJf "/tmp/$f" -C "$d/$arch" --strip-components=1; \
    rm "/tmp/$f"; \
    setpriv --reuid=runner --regid=runner --init-groups touch "$d/$arch.complete"

# Lux runs nested workloads without no-new-privileges, so any setuid or
# setgid program would let the job become root in its container. Strip them
# all; newuidmap/newgidmap get only the file capability they need.
RUN find / -xdev -type f -perm /6000 -exec chmod ug-s {} +; \
    setcap cap_setuid=ep /usr/bin/newuidmap; \
    setcap cap_setgid=ep /usr/bin/newgidmap; \
    [ -z "$(find / -xdev -type f -perm /6000)" ]

# COPY --chmod would also apply 0644 to a parent directory it creates.
RUN install -d -m 0755 /usr/share/lux-gha
COPY --chmod=644 LICENSE /usr/share/lux-gha/LICENSE
COPY --chmod=755 entrypoint.sh /usr/local/bin/lux-gha-runner
# The in-region registry: credential helper, its AWS profile and
# credential_process, and the job-started hook (README "In-region image registry").
RUN install -d -m 0755 /etc/lux-gha
COPY --chmod=755 docker-credential-lux-gha.sh /usr/local/bin/docker-credential-lux-gha
COPY --chmod=755 lux-gha-aws-credentials.sh /usr/local/bin/lux-gha-aws-credentials
COPY --chmod=755 job-started.sh /usr/local/lib/lux-gha/job-started.sh
COPY --chmod=644 aws-config /etc/lux-gha/aws-config

# Declared here, not at the top of the stage, so that a BuildKit bump
# rebuilds only the layers from here on.
ARG BUILDKIT_VERSION
ARG BUILDKIT_DIGEST
LABEL io.github.marcioapm.lux-gha.buildkit="moby/buildkit:${BUILDKIT_VERSION}@${BUILDKIT_DIGEST}"
COPY --link --from=buildkit-archive /out/ /

# The runner installs setup-* tools under RUNNER_TOOL_CACHE, else <work>/_tool.
# actions/setup-python's CPython is built --enable-shared with its RUNPATH
# fixed at /opt/hostedtoolcache/Python/<v>/<arch>/lib, so elsewhere it loads
# libpython only while LD_LIBRARY_PATH is set. AGENT_TOOLSDIRECTORY is the
# older name, read by some setup-* installer scripts.
ENV RUNNER_DIR=/home/runner/actions-runner \
    RUNNER_USER=runner \
    HOME=/home/runner \
    XDG_RUNTIME_DIR=/tmp/xdg \
    DOCKER_HOST=unix:///tmp/xdg/docker.sock \
    RUNNER_TOOL_CACHE=/opt/hostedtoolcache \
    AGENT_TOOLSDIRECTORY=/opt/hostedtoolcache

USER runner
WORKDIR /home/runner
ENTRYPOINT ["/usr/local/bin/lux-gha-runner"]
